{
  "name": "oathly",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "db/local.sh start",
    "db:stop": "db/local.sh stop",
    "db:reset": "db/local.sh reset",
    "db:migrate": "db/local.sh migrate",
    "db:test": "db/local.sh test",
    "db:types": "db/local.sh types",
    "db:deploy": "dbmate --url \"${DATABASE_URL:?Set DATABASE_URL to the Neon connection string}\" --migrations-dir db/migrations --migrations-table private.schema_migrations --no-dump-schema up"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@neondatabase/neon-js": "0.7.0-beta",
    "dbmate": "^2.36.0",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "prettier": "^3.9.9",
    "turbo": "^2.11.5",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
