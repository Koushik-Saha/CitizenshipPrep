# Copy to .env.local and fill in. Never commit real values.
# Quote every value: connection strings contain "&".
#
# In production these are set on the host (Vercel: Project > Settings >
# Environment Variables), not in a file. docs/launch.md says which are needed
# to go live and where each value comes from. Everything here is server-side:
# the only values a browser sees are the ones starting NEXT_PUBLIC_. The phone
# app has its own, all public: apps/mobile/.env.example.

# Neon connection strings for the database owner role, from the Neon console.
# Pooled ("-pooler" in the host) for the apps and the content CLI; direct for
# migrations (`pnpm db:deploy`). Server-side only: never ship these to a client.
# Local development and tests do not need them: they use the Docker database
# started by `pnpm db:start`.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Claude API key, used by `pnpm content draft` and `pnpm content translate`.
ANTHROPIC_API_KEY=""

# Text-to-speech for audio mode, used by `pnpm content audio` to record
# published questions being read aloud. A Google Cloud API key with the
# Text-to-Speech API enabled. Without it nothing is recorded and the apps read
# questions with the device's own voice instead.
# To try the pipeline with no account, set TTS_PROVIDER="macos" (this Mac's voices).
GOOGLE_TTS_API_KEY=""
TTS_PROVIDER=""

# Plans on the web: Stripe. Use test-mode values (sk_test_..., and prices made
# in test mode) until you are ready to charge. See apps/web/scripts/billing/README.md.
# Without these, the plans page shows the plans but nothing can be bought.
STRIPE_SECRET_KEY=""
# From the webhook endpoint in the Stripe dashboard, or printed by `stripe listen`.
STRIPE_WEBHOOK_SECRET=""
# The price of each plan: Pro monthly and yearly are recurring prices, the
# Country Pass a one-time price.
STRIPE_PRICE_PRO_MONTHLY=""
STRIPE_PRICE_PRO_YEARLY=""
STRIPE_PRICE_COUNTRY_PASS=""
# Each needs something set up in the Stripe dashboard first, or Stripe refuses
# every checkout. Set to "1" once it is:
# STRIPE_TAX: Stripe Tax is switched on (Stripe works out VAT, GST and sales
#   tax from the buyer's address).
# STRIPE_TERMS_CONSENT: the address of your terms is in Stripe's public
#   details (buyers must tick a box to accept them).
STRIPE_TAX=""
STRIPE_TERMS_CONSENT=""
# Organizations: the recurring price of one seat (per month or per year, as
# the price says). Leave empty and seats are not sold; staff can still grant
# them (organizations.seat_limit). For admins to change their seat count
# themselves, let customers update quantities in the customer portal settings.
STRIPE_PRICE_ORG_SEAT=""

# Email, through Mailtrap (mailtrap.io): invitations to an organization, and
# what people write in the contact form (/contact). Leave either of the first
# two empty and no email is sent: an organization's admin is shown each
# invitation link to pass on instead, and the contact page shows the support
# address in place of its form.
# MAILTRAP_TOKEN: an API token (Mailtrap > Settings > API Tokens).
# EMAIL_FROM: must be on a sending domain verified in Mailtrap,
#   e.g. "Swornly <invites@example.com>".
MAILTRAP_TOKEN=""
EMAIL_FROM=""
# Development only: the id of a Mailtrap sandbox inbox. With it set, mail is
# kept in that inbox to be read there and reaches nobody. Never set it in
# production.
MAILTRAP_INBOX_ID=""
# Where the contact form sends what people write. Left empty, it goes to
# LEGAL_CONTACT_EMAIL. Use an address on a domain of your own, such as
# support@your-domain: replies come from it.
SUPPORT_EMAIL=""

# Plans in the mobile app: RevenueCat tells the server about App Store and
# Google Play purchases. Make up a long random value, and set it as the
# webhook's Authorization header in RevenueCat's dashboard:
#   openssl rand -hex 32
REVENUECAT_WEBHOOK_SECRET=""
# Purchases made with a store test account ("sandbox") cost nothing and are
# ignored. To let them count: for everyone, on a test server only, set
# REVENUECAT_ALLOW_SANDBOX="1"; for named accounts (the store reviewer's), list
# their Swornly account ids, comma separated, in REVENUECAT_SANDBOX_USERS.
REVENUECAT_ALLOW_SANDBOX=""
REVENUECAT_SANDBOX_USERS=""

# The reviewers' area (/admin). Staff sign in with their own account, which
# must hold a staff role (`pnpm content staff-grant --email ... --role admin`),
# and a code from an authenticator app they set up on their first visit.
#
# ADMIN_SECRET signs their sessions and seals their authenticator secrets:
# `openssl rand -hex 32`. Left empty, NEON_AUTH_COOKIE_SECRET is used instead.
# Set it before anyone sets up an authenticator. Changing it later signs staff
# out and leaves their authenticators unreadable: run
# `pnpm content staff-reset-2fa` for each, and they set one up again.
ADMIN_SECRET=""
# The shared account that came before. It works only until the first admin
# has set up an authenticator, and never again after that: it is how that
# first admin gets in. Leave both empty on a new installation, and delete
# them from the host once you are in with your own account.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Neon Auth (managed Better Auth): enable it on the Neon console's Auth page and
# copy the Auth URL here. The cookie secret is yours to generate:
#   openssl rand -base64 36
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Publish webhook (POST /api/revalidate). The content CLI calls it after
# changing countries or exam formats so the static public pages rebuild.
# Generate the secret with: openssl rand -hex 32
REVALIDATE_SECRET=""
# Where the web app runs: for the CLI to reach the webhook, and for the
# addresses search engines are given (canonical links, hreflang, sitemap.xml,
# preview images). On the host, set it to the public address before building,
# e.g. https://swornly.app: the public pages are built ahead of time.
SITE_URL="http://localhost:3000"

# --- Error reporting (Sentry). Optional: without a DSN nothing is loaded or sent.
# The same project's DSN in both; the public one is what browsers report to.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
# Only to upload source maps at build time, so errors read as the code written.
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# --- Product analytics (PostHog). Optional: without a key nothing is sent.
# Events are sent from the server only (signup, first question, mock exam,
# upgrade, exam result), keyed by account id: nothing is added to the browser.
POSTHOG_KEY=""
# https://us.i.posthog.com (the default) or https://eu.i.posthog.com
POSTHOG_HOST=""

# --- A second AI model. Optional: Google's Gemini answers explanations and
# tutor messages when Claude cannot start an answer (no credit, a rejected
# key, an outage). With only this key set, Gemini answers everything.
# Use a key from a Google project with billing on: on the free tier Google
# may use what is sent to improve its products.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=""
# Which Gemini model. Default gemini-3.5-flash-lite.
GEMINI_MODEL=""

# --- AI cost controls. All optional.
# AI requests (explanations, tutor messages) the whole service may make in 24
# hours. Past it, free accounts are told AI help is paused; past twice it,
# everyone is. Default 5000. Whoever runs the service is told through error
# reporting at 80% and at 100%.
AI_DAILY_LIMIT=""
# Switches that turn a feature off without a release: set to "1" and redeploy.
# DISABLE_AI turns off the tutor and explanations together.
DISABLE_AI=""
DISABLE_AI_TUTOR=""
DISABLE_AI_EXPLANATIONS=""
DISABLE_COMMUNITY=""
# --- Rate limiting. Optional: the key that network and email addresses are
# hashed with before being counted. Defaults to one derived from DATABASE_URL.
RATE_LIMIT_SECRET=""

# --- Who runs the service, for the privacy policy and the terms (/privacy,
# /terms, /delete-account). Required before going live: a policy has to name
# who is responsible and how to reach them. Read at build time.
LEGAL_OPERATOR=""
LEGAL_CONTACT_EMAIL=""
# Optional: a postal address, and whose law governs the terms.
LEGAL_ADDRESS=""
LEGAL_JURISDICTION=""

# --- Optional labels for error reports ("production", "preview").
SENTRY_ENVIRONMENT=""
NEXT_PUBLIC_SENTRY_ENVIRONMENT=""

# --- Development and tests only. Never set these in production.
# Lets automated tests sign in without an inbox (apps/web/e2e/README.md). It
# only works on a development server; a production build ignores it.
TEST_SIGN_IN_SECRET=""
# Runs the database-backed tests: the local Docker database's address.
TEST_DATABASE_URL=""
# Lets the phone app's browser build call a local web server (CORS).
EXPO_WEB_ORIGIN=""
