# Copy to .env.local and fill in. Never commit real values.
# Quote every value: connection strings contain "&".

# Neon connection strings for the database owner role, from the Neon console.
# Pooled ("-pooler" in the host) for the apps and the content CLI; direct for
# migrations (`pnpm db:deploy`). Server-side only: never ship these to a client.
# Local development and tests do not need them: they use the Docker database
# started by `pnpm db:start`.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Claude API key, used by `pnpm content draft` and `pnpm content translate`.
ANTHROPIC_API_KEY=""

# Interim sign-in for /admin (HTTP Basic auth). Leave either empty and the
# admin area does not exist. The password must be at least 12 characters.
ADMIN_USERNAME=""
ADMIN_PASSWORD=""

# Neon Auth (managed Better Auth): enable it on the Neon console's Auth page and
# copy the Auth URL here. The cookie secret is yours to generate:
#   openssl rand -base64 36
NEON_AUTH_BASE_URL=""
NEON_AUTH_COOKIE_SECRET=""

# Publish webhook (POST /api/revalidate). The content CLI calls it after
# changing countries or exam formats so the static public pages rebuild.
# Generate the secret with: openssl rand -hex 32
REVALIDATE_SECRET=""
# Where the web app runs, for the CLI to reach the webhook.
SITE_URL="http://localhost:3000"
