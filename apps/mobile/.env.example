# Copy to .env.local for development. Everything here is public: it is
# inlined into the app at build time and anyone with the app can read it.
# Never put a secret in a variable starting EXPO_PUBLIC_.
#
# For store builds these are set in EAS, per environment (docs/launch.md):
#   eas env:create --environment production --name EXPO_PUBLIC_API_URL --value https://...

# The web app's origin: where the API is. On a phone in development, use your
# computer's LAN address, not localhost.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# The Neon Auth URL (the same value as NEON_AUTH_BASE_URL on the server).
EXPO_PUBLIC_NEON_AUTH_URL=""

# RevenueCat's public SDK keys, one per store. Without them the plans screen
# shows the plans but nothing can be bought.
EXPO_PUBLIC_REVENUECAT_IOS_KEY=""
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=""

# Error reporting (Sentry). Optional: without it nothing is loaded or sent.
EXPO_PUBLIC_SENTRY_DSN=""
EXPO_PUBLIC_SENTRY_ENVIRONMENT=""

# Development only: opens the app signed in as a test learner (see README.md).
# A release build ignores it.
EXPO_PUBLIC_TEST_SESSION=""
