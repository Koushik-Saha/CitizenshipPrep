{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
          "description": "A UUID for the question, the same wherever it goes."
        },
        "country_iso": {
          "type": "string",
          "pattern": "^[A-Z]{2}$",
          "description": "ISO 3166-1 alpha-2 country code, upper case."
        },
        "exam_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Which version of the exam it belongs to, as the country names it: \"civics-2025\"."
        },
        "topic": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtopic": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "difficulty": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5,
          "description": "1 is the easiest, 5 the hardest."
        },
        "language": {
          "type": "string",
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
          "description": "The language the question is written in."
        },
        "question": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "explanation": {
          "type": "string",
          "minLength": 20,
          "maxLength": 1200,
          "description": "Why the answer is right, in plain language: two to four sentences."
        },
        "source": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300,
              "description": "The document the question is drawn from."
            },
            "url": {
              "type": "string",
              "maxLength": 2000,
              "pattern": "^https?:\\/\\/",
              "description": "Where that document is published."
            },
            "section_or_page": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Where in it: a section heading, a page, a question number."
            },
            "quote_under_25_words": {
              "type": "string",
              "maxLength": 300,
              "pattern": "^\\s*\\S+(?:\\s+\\S+){0,23}\\s*$",
              "description": "The words in the source that the answer rests on, copied exactly: fewer than 25 words, and at most 300 characters for scripts written without spaces."
            },
            "publisher": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Who published it: the government body or its exam provider."
            },
            "license": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100,
              "description": "What allows its use: \"public-domain\", an open licence by name, or \"permission\"."
            }
          },
          "required": [
            "title",
            "url",
            "section_or_page",
            "quote_under_25_words",
            "publisher",
            "license"
          ],
          "additionalProperties": false,
          "description": "The official document a question comes from."
        },
        "origin": {
          "type": "string",
          "enum": [
            "official",
            "original"
          ],
          "description": "\"official\": the wording is the government's own published question. \"original\": written by Oathly from the official material."
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
              "description": "ISO 3166-2 subdivision code: a state, canton or Land."
            },
            {
              "type": "null"
            }
          ],
          "description": "The state, canton or Land it is asked in, where the exam varies by region; otherwise null."
        },
        "status": {
          "type": "string",
          "const": "draft",
          "description": "A record in a file is always a draft: review happens in the app."
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "description": "ISO 8601 date and time with a time zone, e.g. 2026-10-08T12:00:00Z."
        },
        "verified_at": {
          "type": "null",
          "description": "Always null in a file: only a reviewer sets it, in the app."
        },
        "type": {
          "type": "string",
          "const": "multiple_choice"
        },
        "options": {
          "minItems": 2,
          "maxItems": 6,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "correct_option_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "description": "Which option is right, counting from 0."
        }
      },
      "required": [
        "id",
        "country_iso",
        "exam_version",
        "topic",
        "subtopic",
        "difficulty",
        "language",
        "question",
        "explanation",
        "source",
        "origin",
        "region",
        "status",
        "created_at",
        "verified_at",
        "type",
        "options",
        "correct_option_index"
      ],
      "additionalProperties": false
    },
