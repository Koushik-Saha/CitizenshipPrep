{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "iso": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code, upper case."
    },
    "researched_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "ISO 8601 date and time with a time zone, e.g. 2026-10-08T12:00:00Z."
    },
    "sources": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 60,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
            "description": "A short name for the source, unique in the pack: \"study-guide-2025\"."
          },
          "kind": {
            "type": "string",
            "enum": [
              "study_guide",
              "question_bank",
              "practice_test",
              "interview_questions",
              "format_page",
              "legislation",
              "other"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "url": {
            "type": "string",
            "maxLength": 2000,
            "pattern": "^https?:\\/\\/",
            "description": "A web address (https, or http where the publisher offers nothing else)."
          },
          "publisher": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "publication_date": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "null"
              }
            ],
            "description": "As printed on the document; null if it has none."
          },
          "version": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              {
                "type": "null"
              }
            ],
            "description": "The edition or revision as the publisher names it."
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
            "description": "BCP 47 language tag."
          },
          "region": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$",
                "description": "ISO 3166-2 subdivision code: a state, canton or Land."
              },
              {
                "type": "null"
              }
            ],
            "description": "For a regional variant, the region it is for."
          },
          "license": {
            "type": "object",
            "properties": {
              "class": {
                "type": "string",
                "enum": [
                  "public_domain",
                  "open_license",
                  "reuse_unclear",
                  "all_rights_reserved"
                ],
                "description": "public_domain: the law or the document says so. open_license: a named licence. all_rights_reserved: reuse needs permission. reuse_unclear: no terms found, or they do not settle it."
              },
              "name": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The licence by name, e.g. \"CC BY 4.0\". Needed for open_license."
              },
              "commercial_use": {
                "type": "string",
                "enum": [
                  "allowed",
                  "not_allowed",
                  "unknown"
                ],
                "description": "Whether the terms let a paid app reuse it."
              },
              "text": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4000
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "The licence or terms-of-use wording relied on, copied exactly. Null only when none was found."
              },
              "url": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000,
                    "pattern": "^https?:\\/\\/",
                    "description": "A web address (https, or http where the publisher offers nothing else)."
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Where that wording is published."
              }
            },
            "required": [
              "class",
              "name",
              "commercial_use",
              "text",
              "url"
            ],
            "additionalProperties": false,
            "description": "What the publisher allows, as read from its own words."
          },
          "file": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,150}$"
              },
              {
                "type": "null"
              }
            ],
            "description": "The downloaded copy, a file in this folder. Null when it cannot be downloaded (an interactive test)."
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256, lower-case hex."
              },
              {
                "type": "null"
              }
            ],
            "description": "Of the file as downloaded."
          },
          "text_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "SHA-256, lower-case hex."
              },
              {
                "type": "null"
              }
            ],
            "description": "Of the text taken from the file: steadier than the bytes for a web page."
          },
          "bytes": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "description": "ISO 8601 date and time with a time zone, e.g. 2026-10-08T12:00:00Z."
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "kind",
          "title",
          "url",
          "publisher",
          "publication_date",
          "version",
          "language",
          "region",
          "license",
          "file",
          "sha256",
          "text_sha256",
          "bytes",
          "retrieved_at",
          "notes"
        ],
        "additionalProperties": false
      }
    },
    "not_found": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "study_guide",
              "question_bank",
              "practice_test",
              "interview_questions",
              "format_page",
              "legislation",
              "other"
            ]
          },
          "searched": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600,
            "description": "Where it was looked for, and what was there instead."
          }
        },
        "required": [
          "kind",
          "searched"
        ],
        "additionalProperties": false
      },
      "description": "Kinds of resource that were looked for and do not exist, or could not be found."
    }
  },
  "required": [
    "iso",
    "researched_at",
    "sources",
    "not_found"
  ],
  "additionalProperties": false,
  "title": "Source pack",
  "description": "Every official study resource found for one country: where it is, what was downloaded, and what its publisher allows.",
  "$id": "sources.schema.json"
}
