{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$"
    },
    "country_iso": {
      "type": "string",
      "pattern": "^[A-Z]{2}$",
      "description": "ISO 3166-1 alpha-2 country code, upper case."
    },
    "topic": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "subtopic": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        {
          "type": "null"
        }
      ]
    },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "description": "BCP 47 language tag."
    },
    "front": {
      "type": "string",
      "minLength": 3,
      "maxLength": 300,
      "description": "The prompt: a question or a term."
    },
    "back": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600,
      "description": "The fact, in a sentence or two."
    },
    "source": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "maxLength": 2000,
          "pattern": "^https?:\\/\\/",
          "description": "A web address (https, or http where the publisher offers nothing else)."
        },
        "section_or_page": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "url",
        "section_or_page"
      ],
      "additionalProperties": false
    },
    "needs_freshness_check": {
      "type": "boolean"
    }
  },
  "required": [
    "id",
    "country_iso",
    "topic",
    "subtopic",
    "language",
    "front",
    "back",
    "source",
    "needs_freshness_check"
  ],
  "additionalProperties": false,
  "title": "Flashcard",
  "description": "One key fact, with the official page it comes from.",
  "$id": "flashcard.schema.json"
}
